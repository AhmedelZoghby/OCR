import json
from ortools.sat.python import cp_model


def slot(day_idx, shift_idx):
    return day_idx * 2 + shift_idx


def main():
    # -----------------------------
    # Data
    # -----------------------------
    developers = [
        'DA', 'DB', 'DC', 'DD', 'DE', 'DF', 'DG', 'DH', 'DI', 'DJ',
        'DK', 'DL', 'DM', 'DN', 'DO', 'DP', 'DQ', 'DR', 'DS', 'DT'
    ]

    rates = {
        'DA': 20, 'DB': 22, 'DC': 24, 'DD': 25, 'DE': 26,
        'DF': 28, 'DG': 30, 'DH': 32, 'DI': 40, 'DJ': 60,
        'DK': 85, 'DL': 85, 'DM': 23, 'DN': 24, 'DO': 27,
        'DP': 29, 'DQ': 31, 'DR': 33, 'DS': 36, 'DT': 38
    }

    projects = ['PA', 'PB', 'PC', 'PD', 'PE']

    # effort in developer-shifts (1 shift = 8 hours)
    effort = {
        'PA': 4,
        'PB': 3,
        'PC': 5,
        'PD': 6,
        'PE': 8
    }

    eligibility = {
        'DA': {'PA', 'PB'},
        'DB': {'PB', 'PC'},
        'DC': {'PC', 'PD'},
        'DD': {'PA', 'PD'},
        'DE': {'PA', 'PC'},
        'DF': {'PB', 'PD'},
        'DG': {'PA', 'PB', 'PC'},
        'DH': {'PA', 'PB', 'PC', 'PE'},
        'DI': {'PE'},
        'DJ': {'PA', 'PB', 'PC', 'PD', 'PE'},
        'DK': {'PA', 'PB', 'PC', 'PD', 'PE'},
        'DL': {'PA', 'PB', 'PC', 'PD', 'PE'},
        'DM': {'PA', 'PD'},
        'DN': {'PB', 'PC', 'PD'},
        'DO': {'PA', 'PC', 'PE'},
        'DP': {'PB', 'PD', 'PE'},
        'DQ': {'PA', 'PB', 'PD'},
        'DR': {'PE', 'PC', 'PD'},
        'DS': {'PA', 'PB', 'PC', 'PE'},
        'DT': {'PD', 'PE'}
    }

    onboarding_costs = {
        'PA': 90,
        'PB': 70,
        'PC': 80,
        'PD': 60,
        'PE': 120
    }

    days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
    shift_names = ['Morning', 'Evening']

    # -----------------------------
    # Model
    # -----------------------------
    model = cp_model.CpModel()

    # assign[(dev, day, shift, project)] = 1 if dev works that project in that shift
    assign = {}
    for d in developers:
        for day in range(7):
            for shift in range(2):
                for p in projects:
                    if p in eligibility[d]:
                        assign[(d, day, shift, p)] = model.NewBoolVar(f'assign_{d}_{day}_{shift}_{p}')

    # work[(dev, day, shift)] = 1 if dev works anything in that shift
    work = {}
    for d in developers:
        for day in range(7):
            for shift in range(2):
                work[(d, day, shift)] = model.NewBoolVar(f'work_{d}_{day}_{shift}')
                possible = [
                    assign[(d, day, shift, p)]
                    for p in projects
                    if (d, day, shift, p) in assign
                ]
                if possible:
                    model.Add(sum(possible) == work[(d, day, shift)])
                    model.Add(sum(possible) <= 1)
                else:
                    model.Add(work[(d, day, shift)] == 0)

    # -----------------------------
    # Core constraints
    # -----------------------------

    # At most 1 shift per day per developer
    for d in developers:
        for day in range(7):
            model.Add(work[(d, day, 0)] + work[(d, day, 1)] <= 1)

    # At most 3 developers per shift
    for day in range(7):
        for shift in range(2):
            model.Add(sum(work[(d, day, shift)] for d in developers) <= 3)

    # Exact effort for each project
    for p in projects:
        model.Add(
            sum(
                assign[(d, day, shift, p)]
                for d in developers
                for day in range(7)
                for shift in range(2)
                if (d, day, shift, p) in assign
            ) == effort[p]
        )

    # If PB appears in a shift, PE must also appear in that shift
    for d in developers:
        for day in range(7):
            for shift in range(2):
                if (d, day, shift, 'PB') in assign:
                    pe_same_shift = [
                        assign[(d2, day, shift, 'PE')]
                        for d2 in developers
                        if (d2, day, shift, 'PE') in assign
                    ]
                    if pe_same_shift:
                        model.Add(assign[(d, day, shift, 'PB')] <= sum(pe_same_shift))
                    else:
                        model.Add(assign[(d, day, shift, 'PB')] == 0)

    # PD must be fully done before PA starts
    for d in developers:
        for day in range(7):
            for shift in range(2):
                if (d, day, shift, 'PA') in assign:
                    t = slot(day, shift)
                    pd_before = [
                        assign[(d2, prev_day, prev_shift, 'PD')]
                        for d2 in developers
                        for prev_day in range(7)
                        for prev_shift in range(2)
                        if (d2, prev_day, prev_shift, 'PD') in assign and slot(prev_day, prev_shift) < t
                    ]
                    if len(pd_before) < effort['PD']:
                        model.Add(assign[(d, day, shift, 'PA')] == 0)
                    else:
                        model.Add(effort['PD'] * assign[(d, day, shift, 'PA')] <= sum(pd_before))

    # Need 3 PA developer-shifts before any PC starts
    for d in developers:
        for day in range(7):
            for shift in range(2):
                if (d, day, shift, 'PC') in assign:
                    t = slot(day, shift)
                    pa_before = [
                        assign[(d2, prev_day, prev_shift, 'PA')]
                        for d2 in developers
                        for prev_day in range(7)
                        for prev_shift in range(2)
                        if (d2, prev_day, prev_shift, 'PA') in assign and slot(prev_day, prev_shift) < t
                    ]
                    if len(pa_before) < 3:
                        model.Add(assign[(d, day, shift, 'PC')] == 0)
                    else:
                        model.Add(3 * assign[(d, day, shift, 'PC')] <= sum(pa_before))

    # At most 2 developers on the same project in the same shift
    for day in range(7):
        for shift in range(2):
            for p in projects:
                model.Add(
                    sum(
                        assign[(d, day, shift, p)]
                        for d in developers
                        if (d, day, shift, p) in assign
                    ) <= 2
                )

    # Evening shift -> no next morning
    for d in developers:
        for day in range(6):
            model.Add(work[(d, day, 1)] + work[(d, day + 1, 0)] <= 1)

    # -----------------------------
    # Availability and conflicts
    # -----------------------------

    # DA no Evening
    for day in range(7):
        model.Add(work[('DA', day, 1)] == 0)

    # DL no Morning
    for day in range(7):
        model.Add(work[('DL', day, 0)] == 0)

    # DJ and DK off Sunday
    for shift in range(2):
        model.Add(work[('DJ', 0, shift)] == 0)
        model.Add(work[('DK', 0, shift)] == 0)

    # DM off Monday and Friday
    for shift in range(2):
        model.Add(work[('DM', 1, shift)] == 0)
        model.Add(work[('DM', 5, shift)] == 0)

    # DN no Evening
    for day in range(7):
        model.Add(work[('DN', day, 1)] == 0)

    # DR off Wednesday and Thursday
    for shift in range(2):
        model.Add(work[('DR', 3, shift)] == 0)
        model.Add(work[('DR', 4, shift)] == 0)

    # DB off Tuesday
    for shift in range(2):
        model.Add(work[('DB', 2, shift)] == 0)

    # DN cannot work with DB
    for day in range(7):
        for shift in range(2):
            model.Add(work[('DN', day, shift)] + work[('DB', day, shift)] <= 1)

    # DR cannot work with DC
    for day in range(7):
        for shift in range(2):
            model.Add(work[('DR', day, shift)] + work[('DC', day, shift)] <= 1)

    # DC and DD cannot work together
    for day in range(7):
        for shift in range(2):
            model.Add(work[('DC', day, shift)] + work[('DD', day, shift)] <= 1)

    # If DI works on PE, one of DL / DJ / DK must also be in that shift
    for day in range(7):
        for shift in range(2):
            if ('DI', day, shift, 'PE') in assign:
                model.Add(
                    assign[('DI', day, shift, 'PE')] <=
                    work[('DL', day, shift)] + work[('DJ', day, shift)] + work[('DK', day, shift)]
                )

    # -----------------------------
    # Project E shift pattern
    # -----------------------------
    pe_active = {}
    for day in range(7):
        for shift in range(2):
            pe_active[(day, shift)] = model.NewBoolVar(f'pe_active_{day}_{shift}')
            pe_assignments = [
                assign[(d, day, shift, 'PE')]
                for d in developers
                if (d, day, shift, 'PE') in assign
            ]
            if pe_assignments:
                model.AddMaxEquality(pe_active[(day, shift)], pe_assignments)
            else:
                model.Add(pe_active[(day, shift)] == 0)

    model.Add(sum(pe_active[(day, shift)] for day in range(7) for shift in range(2)) == 5)
    model.Add(sum(pe_active[(day, 1)] for day in range(7)) >= 2)

    # -----------------------------
    # Distinct developer caps
    # -----------------------------
    uses_project = {}
    for d in developers:
        for p in projects:
            uses_project[(d, p)] = model.NewBoolVar(f'uses_{d}_{p}')
            used_somewhere = [
                assign[(d, day, shift, p)]
                for day in range(7)
                for shift in range(2)
                if (d, day, shift, p) in assign
            ]
            if used_somewhere:
                model.AddMaxEquality(uses_project[(d, p)], used_somewhere)
            else:
                model.Add(uses_project[(d, p)] == 0)

    for p in ['PA', 'PB', 'PC', 'PD']:
        model.Add(sum(uses_project[(d, p)] for d in developers) <= 2)
    model.Add(sum(uses_project[(d, 'PE')] for d in developers) <= 3)

    # If DS uses PE anywhere, DS cannot use PB
    model.Add(uses_project[('DS', 'PB')] == 0).OnlyEnforceIf(uses_project[('DS', 'PE')])

    # -----------------------------
    # Shift activation
    # -----------------------------
    used_shift = {}
    for day in range(7):
        for shift in range(2):
            used_shift[(day, shift)] = model.NewBoolVar(f'used_shift_{day}_{shift}')
            model.AddMaxEquality(used_shift[(day, shift)], [work[(d, day, shift)] for d in developers])

    # -----------------------------
    # Weekly shift counts and overtime
    # -----------------------------
    total_shifts = {}
    overtime_shifts = {}

    for d in developers:
        total_shifts[d] = model.NewIntVar(0, 5, f'total_shifts_{d}')
        model.Add(
            total_shifts[d] == sum(work[(d, day, shift)] for day in range(7) for shift in range(2))
        )

        model.Add(total_shifts[d] <= 5)

        if d == 'DO':
            model.Add(total_shifts[d] <= 3)

        overtime_shifts[d] = model.NewIntVar(0, 5, f'overtime_shifts_{d}')
        model.Add(overtime_shifts[d] >= total_shifts[d] - 3)
        model.Add(overtime_shifts[d] >= 0)
        model.Add(overtime_shifts[d] <= total_shifts[d])

    # Exactly one developer works exactly 5 shifts
    works_five = {}
    for d in developers:
        works_five[d] = model.NewBoolVar(f'works_five_{d}')
        model.Add(total_shifts[d] == 5).OnlyEnforceIf(works_five[d])
        model.Add(total_shifts[d] <= 4).OnlyEnforceIf(works_five[d].Not())
    model.Add(sum(works_five[d] for d in developers) == 1)

    # -----------------------------
    # DT onboarding waiver on PE
    # -----------------------------
    dt_di_pair_pe = {}
    for day in range(7):
        for shift in range(2):
            dt_di_pair_pe[(day, shift)] = model.NewBoolVar(f'dt_di_pair_pe_{day}_{shift}')

            dt_pe = assign.get(('DT', day, shift, 'PE'))
            di_pe = assign.get(('DI', day, shift, 'PE'))

            if dt_pe is not None and di_pe is not None:
                model.Add(dt_di_pair_pe[(day, shift)] <= dt_pe)
                model.Add(dt_di_pair_pe[(day, shift)] <= di_pe)
                model.Add(dt_di_pair_pe[(day, shift)] >= dt_pe + di_pe - 1)
            else:
                model.Add(dt_di_pair_pe[(day, shift)] == 0)

    dt_pe_waived = model.NewBoolVar('dt_pe_waived')
    model.AddMaxEquality(
        dt_pe_waived,
        [dt_di_pair_pe[(day, shift)] for day in range(7) for shift in range(2)]
    )

    dt_pe_charge = model.NewBoolVar('dt_pe_charge')
    model.Add(dt_pe_charge + dt_pe_waived == uses_project[('DT', 'PE')])

    # -----------------------------
    # Objective
    # -----------------------------
    labor_terms = []
    for d in developers:
        r = rates[d]
        labor_terms.append(8 * r * total_shifts[d])
        labor_terms.append(4 * r * overtime_shifts[d])

    labor_cost = model.NewIntVar(0, 2_000_000, 'labor_cost')
    model.Add(labor_cost == sum(labor_terms))

    shift_cost = model.NewIntVar(0, 2_000_000, 'shift_cost')
    model.Add(
        shift_cost ==
        sum(20 * used_shift[(day, 0)] + 200 * used_shift[(day, 1)] for day in range(7))
    )

    onboarding_terms = []
    for d in developers:
        for p in projects:
            if d == 'DT' and p == 'PE':
                continue
            onboarding_terms.append(onboarding_costs[p] * uses_project[(d, p)])

    onboarding_terms.append(onboarding_costs['PE'] * dt_pe_charge)

    onboarding_cost = model.NewIntVar(0, 2_000_000, 'onboarding_cost')
    model.Add(onboarding_cost == sum(onboarding_terms))

    minimum_cost = model.NewIntVar(0, 5_000_000, 'minimum_cost')
    model.Add(minimum_cost == labor_cost + shift_cost + onboarding_cost)

    model.Minimize(minimum_cost)

    # -----------------------------
    # Solve
    # -----------------------------
    solver = cp_model.CpSolver()
    solver.parameters.max_time_in_seconds = 500
    solver.parameters.num_search_workers = 8

    status = solver.Solve(model)

    if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
        schedule = {}

        for day in range(7):
            day_name = days[day]
            schedule[day_name] = {}

            for shift in range(2):
                shift_name = shift_names[shift]
                devs_in_shift = []
                projects_in_shift = []

                for d in developers:
                    if solver.Value(work[(d, day, shift)]) == 1:
                        for p in projects:
                            if (d, day, shift, p) in assign and solver.Value(assign[(d, day, shift, p)]) == 1:
                                devs_in_shift.append(d)
                                projects_in_shift.append(p)
                                break

                schedule[day_name][shift_name] = {
                    "Devs": devs_in_shift,
                    "Projects": projects_in_shift
                }

        print(json.dumps({"minimum_cost": str(solver.Value(minimum_cost))}))
        print()
        print(json.dumps({"schedule": schedule}, indent=2))

    else:
        empty_schedule = {
            day_name: {
                "Morning": {"Devs": [], "Projects": []},
                "Evening": {"Devs": [], "Projects": []}
            }
            for day_name in days
        }

        print(json.dumps({"minimum_cost": "No feasible solution found"}))
        print()
        print(json.dumps({"schedule": empty_schedule}, indent=2))


if __name__ == "__main__":
    main()
